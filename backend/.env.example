# Puerto y host donde escucha la API
PORT=3000
HOST=0.0.0.0

# Ruta del archivo SQLite (debe estar en un disco persistente del servidor)
DB_PATH=./asistencia.db

# URL(s) pública(s) del frontend que pueden consumir la API, separadas por coma.
# Ejemplo: https://asistencia-front.azurestaticapps.net,https://asistencia.midominio.com
# Usa * solo para pruebas.
CORS_ORIGINS=http://localhost:8080
